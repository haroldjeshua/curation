# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated machine surface (rebuilt by prebuild on every build)
public/llms.txt
public/entries.json
/public/sites/
/public/systems/
/public/libraries/
/public/skills/
/public/reading/

# intake staging (personal/raw captures never committed)
# shortlist/ and published/ ARE committed; everything raw stays local.
/intake/candidates/
/intake/seeded/
/intake/*.html
